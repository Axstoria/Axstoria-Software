.color-picker-popup {
    position: absolute;
    width: 200px;
    background-color: rgb(50, 50, 50);
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    border-radius: 4px;
    padding: 8px;
}

.color-picker-preview-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.color-preview {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    margin-right: 6px;
}

.color-hex-field {
    flex-grow: 1;
}

.color-hex-field .unity-text-field__input {
    background-color: rgb(38, 38, 38);
    border-color: rgb(70, 70, 70);
    color: rgb(240, 240, 240);
    --unity-cursor-color: rgb(240, 240, 240);
    height: 24px;
    padding: 2px 6px;
}

.color-swatch-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.color-picker-cell {
    width: 20px;
    height: 20px;
    margin: 2px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
}

.color-picker-cell:hover {
    border-color: rgb(100, 140, 210);
}
